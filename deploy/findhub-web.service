[Unit]
Description=Find Hub tracker web app
After=network-online.target
Wants=network-online.target

[Service]
User=findhub
Environment=FINDHUB_DB=/var/lib/findhub/findhub.db
Environment=FINDHUB_WEB_DIST=/opt/findhub/web/dist
ExecStart=/opt/findhub/server/.venv/bin/uvicorn findhub.web:app --host 127.0.0.1 --port 8400
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/findhub

[Install]
WantedBy=multi-user.target
